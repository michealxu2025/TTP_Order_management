{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Human readable order ID like 260415-1" },
        "customer": { "type": "object", "description": "Customer details" },
        "items": { "type": "array", "description": "List of order items" },
        "totalAmount": { "type": "number", "description": "Total price of the order" },
        "status": { "type": "string", "description": "Order status" },
        "createdAt": { "type": "timestamp", "description": "Creation time" },
        "authorUid": { "type": "string", "description": "User ID of the creator" }
      },
      "required": ["id", "customer", "items", "totalAmount", "status", "createdAt", "authorUid"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application setting",
      "type": "object",
      "properties": {
        "maintenance": { "type": "boolean", "description": "True if system is under maintenance" }
      }
    },
    "CustomerCredential": {
      "title": "CustomerCredential",
      "description": "Customer login credentials managed by sales and admin",
      "type": "object",
      "properties": {
        "customerCode": { "type": "string", "description": "Customer code" },
        "customerName": { "type": "string", "description": "Customer name" },
        "account": { "type": "string", "description": "Customer login account" },
        "password": { "type": "string", "description": "Customer login password" },
        "sales": { "type": "string", "description": "Assigned salesperson" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["customerCode", "account", "password"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Collection of all orders"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Global settings for the application"
    },
    "/customer_credentials/{credId}": {
      "schema": { "$ref": "#/entities/CustomerCredential" },
      "description": "Customer credentials store"
    }
  }
}
